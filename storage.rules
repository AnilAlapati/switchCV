rules_version = '2';

// Firebase Storage Security Rules for SwitchCV
//
// SECURITY NOTE: The /profiles/{userId}/public/ path is intentionally
// publicly readable to allow profile avatars and public assets to be
// displayed to recruiters and other visitors without authentication.
// Write access is still restricted to the owner only.

service firebase.storage {
  match /b/{bucket}/o {
    // Users can upload/read their own files (private by default)
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // Public read for profile assets (avatars, cover images)
    // This is intentional - public profile data must be viewable by recruiters
    match /profiles/{userId}/public/{allPaths=**} {
      allow read: if true;  // Intentionally public for profile visibility
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024 // 2MB for avatars
                   && request.resource.contentType.matches('image/.*'); // Only images
    }
  }
}