# =============================================================================
# Firebase Functions - Local Emulator Environment
# =============================================================================
# Copy this to .env.local in the functions directory for local development
#
# These settings only apply when running firebase emulators:start

# Enable dev bypass for tier/role/quota checks
# Only works when FUNCTIONS_EMULATOR=true (automatically set by emulator)
DEV_BYPASS_CHECKS=true

# Config mode (for v1/v2 → v7 migration)
# Set to "true" to use legacy functions.config() API
# Set to "false" to use environment variables (v7 compatible)
USE_LEGACY_CONFIG=true

# AI Configuration (required for AI search to work)
GEMINI_API_KEY=your_gemini_api_key

# SMTP configuration (used for transactional + alert emails)
# When USE_LEGACY_CONFIG=false, these are used directly
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=support@switchcv.com
SMTP_PASS=your_app_password

# Monitoring P95 thresholds (used when USE_LEGACY_CONFIG=false)
MONITORING_P95_THRESHOLD_DEFAULT=1000
MONITORING_P95_THRESHOLD_AI_API_CALL=5000
MONITORING_P95_THRESHOLD_DATABASE_QUERY=2000
MONITORING_P95_THRESHOLD_FUNCTION_EXECUTION=1500
MONITORING_P95_THRESHOLD_EXTERNAL_API=3000

# Alert routing
ALERT_EMAIL_TO=support@switchcv.com
ALERT_EMAIL_SUBJECT_PREFIX=[SWITCHCV EMERGENCY]
