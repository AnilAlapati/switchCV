# =============================================================================
# Firebase Functions - Local Emulator Environment
# =============================================================================
# Copy this to .env.local in the functions directory for local development
#
# These settings only apply when running firebase emulators:start

# Enable dev bypass for tier/role/quota checks
# Only works when FUNCTIONS_EMULATOR=true (automatically set by emulator)
DEV_BYPASS_CHECKS=true

# AI Configuration (required for AI search to work)
GEMINI_API_KEY=your_gemini_api_key

# SMTP configuration (used for transactional + alert emails)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=support@switchcv.com
SMTP_PASS=your_app_password

# Alert routing
ALERT_EMAIL_TO=support@switchcv.com
ALERT_EMAIL_SUBJECT_PREFIX=[SWITCHCV EMERGENCY]
