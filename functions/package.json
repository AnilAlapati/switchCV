    "logs": "firebase functions:log",
    "test": "jest"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.5",
    "helmet": "^7.1.0",
    "nodemailer": "^7.0.11",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.6",
    "clsx": "^2.1.1",
    "firebase-functions-test": "^3.1.0",
    "jest": "^30.2.0",
    "tailwind-merge": "^3.4.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "private": true,
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "fast-xml-parser": "5.4.2",
