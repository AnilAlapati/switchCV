# ==============================================================================
# SwitchCV Development Environment — Firebase Config
# ==============================================================================
# This file is ONLY loaded when NODE_ENV=development (local dev server).
# Firebase Frameworks always builds with NODE_ENV=production, so this file
# is NEVER loaded during `firebase deploy` builds. That is the whole point.
#
# ✅ This file is safe to commit — it only contains public Firebase config.
# 🔒 Secrets (API keys, tokens) must stay in .env.local (gitignored).
# ==============================================================================

# ==================== FIREBASE DEV (switchcv-dev) ====================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCm1wvOw1fLZssQiJcgL0cDGyIxSH8Ytls
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=switchcv-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=switchcv-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=switchcv-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=810736137134
NEXT_PUBLIC_FIREBASE_APP_ID=1:810736137134:web:8f2dc30604aebd6825ce3f
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-THHW1JM6QN

# Google Cloud project ID
GCLOUD_PROJECT=switchcv-dev
GOOGLE_CLOUD_PROJECT=switchcv-dev

# ==================== APPLICATION (dev) ====================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
WEBSITE_URL=http://localhost:3000

NEXT_PUBLIC_AUTH_VERIFICATION_URL=http://localhost:3000/auth/verify
NEXT_PUBLIC_AUTH_VERIFICATION_PATH=/auth/verify

# Deployment target — keeps dev config guard from firing for dev builds
NEXT_PUBLIC_DEPLOY_TARGET=dev
