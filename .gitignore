# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/functions/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
coverage-*/

# Playwright
/playwright-report/
/test-results/
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.local.backup
.env*.local
.env.dev
.env.production
.env.local.prod-db
functions/.env.dev
functions/.env.default
!.env.example
!functions/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules_old/
*.skip

# firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# functions
functions/lib/

# logs
test-output.log
key.json

# Additional secret files
*.key
*.p12
*.pem
secrets.json
config.local.json
firebase-service-account.json
service-account.json
credentials.json
auth.json

# Sensitive configuration files (contains secrets)
extensions/firestore-send-email.env
firebase_config_*_backup.json
users.json
