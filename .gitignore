# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/functions/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
coverage-*/

# Playwright
/playwright-report/
/test-results/
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER commit actual secrets
.env
.env.local
.env.local.backup
.env.local.*-backup
.env.local.prod-db
.env*.local
.env.dev
# .env.production IS tracked - it only has public Firebase config (no secrets)
.env.production.secrets.backup
functions/.env.dev
functions/.env.default
.env-backups/
# Only allow example/template files (no real credentials)
!.env.example
!.env.*.example
!functions/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules_old/
*.skip

# firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# functions
functions/lib/

# logs
test-output.log
key.json

# Additional secret files
.secrets/
*.key
*.p12
*.pem
secrets.json
config.local.json
firebase-service-account.json
service-account.json
credentials.json
auth.json

# Sensitive configuration files (contains secrets)
extensions/firestore-send-email.env
firebase_config_*_backup.json
users.json
all_users.json
users-check.json
check-after-cleanup.json
config-dev.json
config.local.json
config.*.json
*.json.bak
*.txt.bak
*.log
test-results-fixed.txt
test_run_output.txt
test-output-*.txt
test-failures-*.txt
coverage/
clover.xml
coverage-final.json
coverage-summary.json
lcov.info
lcov-report/

# Snyk reports and scripts
snyk-reports/
snyk-scan-output.txt
parse_snyk.js

# Ignored dangerous scripts
scripts/dev-with-secrets.sh
scripts/rotate-secret.sh
scripts/setup-firestore-backup.sh
scripts/setup-secrets.sh
scripts/sync-secrets-from-firebase.sh
scripts/delete-my-resume-prod.js
src/app/api/admin/test-secrets/route.ts

# Generated test/coverage outputs (do NOT commit — these are ephemeral)
coverage_report.json
coverage_resume.json
full_test_log.txt
test_output.txt
docs/reports/artifacts/
