{
  "name": "switchcv",
  "version": "0.0.77",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:enterprise": "NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=enterprise next dev",
    "dev:enterprise:recruiter": "NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=enterprise NEXT_PUBLIC_DEV_ROLE=recruiter next dev",
    "dev:enterprise:jobseeker": "NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=enterprise NEXT_PUBLIC_DEV_ROLE=jobseeker next dev",
    "dev:premium": "NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=premium next dev",
    "dev:basic": "NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=basic next dev",
    "build": "npm run release && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "postinstall": "chmod +x scripts/*.sh 2>/dev/null || true",
    "cleanup": "bash scripts/auto-maintain.sh",
    "setup:dev": "bash scripts/setup-dev-env.sh",
    "deploy:cloud": "bash scripts/deploy-sync.sh",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "env:dev": "bash scripts/switch-env.sh dev",
    "env:prod": "bash scripts/switch-env.sh prod",
    "health-check": "bash scripts/check-repo-health.sh",
    "release": "node scripts/increment-version.js"
  },
  "dependencies": {
    "@next/third-parties": "^16.0.10",
    "@sentry/nextjs": "^10.27.0",
    "firebase": "^12.5.0",
    "firebase-admin": "^13.6.0",
    "next": "16.0.7",
    "nodemailer": "^7.0.11",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "posthog-js": "^1.298.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.3.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-jest": "^30.2.0",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-tools": "^14.24.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "eslint --max-warnings=0",
      "jest --bail --findRelatedTests"
    ]
  }
}
