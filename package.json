{
  "name": "switchcv",
  "version": "0.0.219",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev-with-secrets.sh",
    "dev:watch": "bash scripts/dev-with-watch.sh",
    "dev:base": "next dev",
    "dev:enterprise": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=enterprise next dev",
    "dev:enterprise:recruiter": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=enterprise NEXT_PUBLIC_DEV_ROLE=recruiter next dev",
    "dev:enterprise:jobseeker": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=enterprise NEXT_PUBLIC_DEV_ROLE=jobseeker next dev",
    "dev:premium": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=premium next dev",
    "dev:basic": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=basic next dev",
    "build": "npm run release && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "audit:perf": "node scripts/audit-performance-standards.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "postinstall": "chmod +x scripts/*.sh 2>/dev/null || true",
    "cleanup": "bash scripts/auto-maintain.sh",
    "setup:dev": "bash scripts/setup-dev-env.sh",
    "setup:hooks": "cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit && echo '✅ Pre-commit hook installed'",
    "quality": "bash scripts/quality-check.sh",
    "quality:quick": "bash scripts/quality-check.sh --quick",
    "quality:fix": "bash scripts/quality-check.sh --fix",
    "quality:watch": "bash scripts/watch-quality.sh",
    "precommit": "bash scripts/quality-check.sh --quick",
    "deploy:cloud": "bash scripts/deploy-sync.sh",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "env:dev": "bash scripts/switch-env.sh dev",
    "env:prod": "bash scripts/switch-env.sh prod",
    "secrets:sync": "bash scripts/sync-secrets-from-firebase.sh",
    "secrets:sync:dev": "bash scripts/sync-secrets-from-firebase.sh switchcv-dev",
    "secrets:sync:prod": "bash scripts/sync-secrets-from-firebase.sh switchcv-e5136",
    "migrate": "tsx scripts/migrate.ts",
    "test:rules": "jest security-rules.test.ts",
    "emulator": "firebase emulators:start --only firestore",
    "health-check": "bash scripts/check-repo-health.sh",
    "release": "node scripts/increment-version.js"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^10.27.0",
    "@types/three": "^0.182.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.5.0",
    "firebase-admin": "^13.6.0",
    "lucide-react": "^0.561.0",
    "motion": "^12.26.2",
    "next": "^16.0.10",
    "next-intl": "^4.7.0",
    "nodemailer": "^7.0.11",
    "path-browserify": "^1.0.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "posthog-js": "^1.324.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.3.6",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-jest": "^30.2.0",
    "baseline-browser-mapping": "^2.9.15",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-tools": "^15.3.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "eslint --max-warnings=0",
      "jest --bail --findRelatedTests"
    ]
  }
}
