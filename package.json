{
  "name": "switchcv",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run release && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "postinstall": "chmod +x scripts/*.sh 2>/dev/null || true",
    "precommit": "bash scripts/auto-maintain.sh",
    "cleanup": "bash scripts/auto-maintain.sh",
    "health-check": "bash scripts/check-repo-health.sh",
    "release": "node scripts/increment-version.js"
  },
  "dependencies": {
    "firebase": "^12.5.0",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^14.24.1",
    "next": "16.0.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-jest": "^30.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "eslint --max-warnings=0",
      "jest --bail --findRelatedTests"
    ]
  }
}
