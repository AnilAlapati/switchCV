{
  "name": "switchcv",
  "version": "0.1.55",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev-with-secrets.sh",
    "dev:watch": "bash scripts/dev-with-watch.sh",
    "dev:base": "next dev",
    "dev:enterprise": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=enterprise next dev",
    "dev:enterprise:recruiter": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=enterprise NEXT_PUBLIC_DEV_ROLE=recruiter next dev",
    "dev:enterprise:jobseeker": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=enterprise NEXT_PUBLIC_DEV_ROLE=jobseeker next dev",
    "dev:premium": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=premium next dev",
    "dev:basic": "bash scripts/dev-with-secrets.sh && NEXT_PUBLIC_DEV_MODE=true NEXT_PUBLIC_DEV_TIER=basic next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "audit:perf": "node scripts/audit-performance-standards.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "postinstall": "chmod +x scripts/*.sh 2>/dev/null || true",
    "cleanup": "bash scripts/auto-maintain.sh",
    "setup:dev": "bash scripts/setup-dev-env.sh",
    "setup:hooks": "cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit && echo '✅ Pre-commit hook installed'",
    "quality": "bash scripts/quality-check.sh",
    "quality:quick": "bash scripts/quality-check.sh --quick",
    "quality:fix": "bash scripts/quality-check.sh --fix",
    "quality:watch": "bash scripts/watch-quality.sh",
    "resume:eval:launch": "tsx scripts/evaluate-resume-launch-gate.ts",
    "resume:eval:creative": "tsx scripts/evaluate-creative-polish-gate.ts",
    "resume:kpi:gate": "tsx scripts/monitoring/resume-kpi-gate.ts",
    "precommit": "bash scripts/quality-check.sh --quick",
    "env:dev": "bash scripts/switch-env.sh dev",
    "env:prod": "bash scripts/switch-env.sh prod",
    "secrets:setup": "bash scripts/setup-firebase-secrets.sh",
    "secrets:setup:dev": "bash scripts/setup-firebase-secrets.sh dev",
    "secrets:setup:prod": "bash scripts/setup-firebase-secrets.sh prod",
    "migrate": "tsx scripts/migrate.ts",
    "test:rules": "jest security-rules.test.ts",
    "emulator": "bash scripts/ensure-java.sh firebase emulators:start --only firestore",
    "health-check": "bash scripts/check-repo-health.sh",
    "release": "node scripts/increment-version.js",
    "backup:local": "bash scripts/backup-env-safe.sh",
    "test:security": "jest --watchman=false --config jest.security.config.cjs",
    "deploy": "bash scripts/deploy.sh sync",
    "deploy:dev": "bash scripts/deploy.sh dev",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "deploy:sync": "bash scripts/deploy.sh sync",
    "deploy:prod:hotfix": "bash scripts/deploy.sh prod --no-bump"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.1",
    "@next/third-parties": "^15.1.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^10.27.0",
    "@types/three": "^0.182.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.6.0",
    "lucide-react": "^0.561.0",
    "mammoth": "^1.11.0",
    "motion": "^12.26.2",
    "next": "^15.5.11",
    "next-intl": "^4.7.0",
    "next-swagger-doc": "^0.4.1",
    "nodemailer": "^7.0.11",
    "path-browserify": "^1.0.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "posthog-js": "^1.324.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "^3.7.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.31.0",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^7.0.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "babel-jest": "^30.2.0",
    "baseline-browser-mapping": "^2.8.32",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-tools": "^15.3.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "eslint --max-warnings=0",
      "jest --bail --findRelatedTests"
    ]
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "overrides": {
    "nanoid": "^3.3.8",
    "fast-xml-parser": "4.5.4",
    "cross-spawn": "^7.0.6",
    "minimatch": "^3.1.5",
    "underscore": "^1.13.8",
    "@tootallnate/once": "3.0.1",
    "@hono/node-server": "1.19.10",
    "basic-ftp": "5.2.0",
    "hono": "4.12.5",
    "rollup": "4.59.0",
    "serialize-javascript": "7.0.4",
    "tar": "7.5.10",
    "terser-webpack-plugin": "5.3.17",
    "dompurify": "3.3.2",
    "immutable": "4.3.8"
  }
}
