# Auto detect text files and perform LF normalization
* text=auto

# Documents
*.md text
*.txt text
*.json text
*.yml text
*.yaml text

# Source code
*.js text
*.jsx text
*.ts text
*.tsx text
*.css text
*.scss text
*.html text

# Prevents corruption of these file types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Large files that should use Git LFS (if needed in future)
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.ai filter=lfs diff=lfs merge=lfs -text
