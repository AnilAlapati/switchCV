rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userRoleIsProtected() {
      // Allow if role is not being set
      return !('role' in request.resource.data)
        // Allow if document doesn't exist (create) and role is valid
        || (resource == null && request.resource.data.role in ['jobseeker', 'recruiter'])
        // Allow if document exists but has no role yet (first role selection)
        || (resource != null && !('role' in resource.data) && request.resource.data.role in ['jobseeker', 'recruiter'])
        // Allow if document exists with role but roleSelectedAt is not set (user hasn't selected role yet - default was set)
        || (resource != null && 'role' in resource.data && !('roleSelectedAt' in resource.data) && request.resource.data.role in ['jobseeker', 'recruiter'])
        // Allow if role matches existing role (no change)
        || (resource != null && 'role' in resource.data && request.resource.data.role == resource.data.role);
    }

    function userTierIsProtected() {
      return !('subscriptionTier' in request.resource.data)
        || (resource == null && request.resource.data.subscriptionTier == 'basic')
        || (resource != null && request.resource.data.subscriptionTier == resource.data.subscriptionTier);
    }

    function recruiterFlagProtected() {
      return !('isRecruiter' in request.resource.data)
        || (resource == null && request.resource.data.isRecruiter == false)
        || (resource != null && request.resource.data.isRecruiter == resource.data.isRecruiter);
    }

    function userDocHasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'username',
        'needsUsername',
        'emailVerified',
        'authProvider',
        'companyName',
        'role',
        'subscriptionTier',
        'isRecruiter',
        'createdAt',
        'updatedAt',
        'settingsUpdatedAt',
        'profileCompletedAt',
        'preferences',
        'metrics',
        'resumeQuota',
        'resumeUsage',
        'connectivityIssue',
        'lastLoginAt',
        'notificationPreferences',
        'maintenanceBypass',
        'tierOverride',
        'subscription',
        'subscriptionStatus',
        'subscriptionExpiresAt',
        'stripeCustomerId',
        'billingStatus',
        'roleUpdatedAt',
        'roleUpdatedBy',
        'roleSelectedAt',
        'plan',
        'planId',
        'planMetadata',
        'planExpiresAt',
        'planRenewalDate',
        'planOverride',
        'planTier',
        'aiUsage',
        'quota',
        'quotaOverrides',
        'featureFlags',
        'policyAcceptances',
        'privacySettings',
        'profile'
      ]);
    }

    function userDocHasRequiredIdentity(userId) {
      return request.resource.data.uid == userId && request.resource.data.email is string;
    }

    // For updates with merge, verify existing document has correct identity
    function existingDocHasCorrectIdentity(userId) {
      return resource.data.uid == userId;
    }

    // Users can read their own user document. Writes are limited to safe fields only.
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && userDocHasOnlyAllowedFields()
        && userDocHasRequiredIdentity(userId)
        && userRoleIsProtected()
        && userTierIsProtected()
        && recruiterFlagProtected();

      allow update: if isOwner(userId)
        && userDocHasOnlyAllowedFields()
        && existingDocHasCorrectIdentity(userId)
        && userRoleIsProtected()
        && userTierIsProtected()
        && recruiterFlagProtected();

      allow delete: if isOwner(userId);
    }

    // Users can read and write their own profiles
    match /profiles/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Username reservations (used during signup/profile completion)
    match /usernames/{usernameId} {
      allow get: if request.auth != null; // Needed to check if a username is available
      allow list: if false; // Prevent bulk username scraping
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Resume templates (read-only for clients)
    match /templates/{templateId} {
      allow read: if true; // Templates are public assets for rendering resumes
      allow write: if false; // Managed via backend/admin tooling only
    }

    // ==================== RECRUITER WORKFLOW ====================

    // Recruiter contact requests
    match /recruiterRequests/{requestId} {
      // Candidate can read their own requests
      allow read: if request.auth != null && request.auth.uid == resource.data.toUserId;
      // Recruiter can read their own requests
      allow read: if request.auth != null && request.auth.uid == resource.data.fromRecruiter.recruiterId;
      // Admins can read all requests (Optimized: uses Custom Claims)
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      
      // SECURITY FIX: Recruiters can create requests only with proper validation
      // - Must be authenticated
      // - Must have recruiter role (Optimized: uses Custom Claims)
      // - fromRecruiter.recruiterId must match the authenticated user
      // - Required fields must be present
      allow create: if request.auth != null 
        && request.auth.token.role == 'recruiter'
        && request.resource.data.fromRecruiter.recruiterId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.status == 'pending';
      
      // Only admins can update (to approve/deny) (Optimized: uses Custom Claims)
      allow update: if request.auth != null && request.auth.token.role == 'admin';
      
      // Prevent deletion
      allow delete: if false;
    }

    // Access tokens for recruiter PII access
    match /accessTokens/{tokenId} {
      // Recruiters can read their own tokens
      allow read: if request.auth != null && request.auth.uid == resource.data.recruiterId;
      // Candidates can verify tokens for their data
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Only backend can create tokens
      allow create: if false;
      
      // Only backend can update (revoke, track usage)
      allow update: if false;
      
      // Prevent deletion
      allow delete: if false;
    }

    // Recruiter notifications
    match /recruiterNotifications/{notificationId} {
      // Recruiters can read their own notifications
      allow read: if request.auth != null && request.auth.uid == resource.data.recruiterId;
      // Recruiters can update their own (mark as read)
      allow update: if request.auth != null && request.auth.uid == resource.data.recruiterId;
      
      // Prevent creation/deletion by users (backend only)
      allow create: if false;
      allow delete: if false;
    }

    // Recruiter search history (server-side analytics & retention only)
    match /recruiterSearchHistory/{eventId} {
      // Clients should never read or write raw search history directly; these
      // documents contain telemetry used for aggregate dashboards only.
      allow read: if false;
      allow write: if false;
    }

    // Admin notifications for request review
    match /adminNotifications/{notificationId} {
      // Only admins can read (Optimized: uses Custom Claims)
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      // Admins can update (mark as read) (Optimized: uses Custom Claims)
      allow update: if request.auth != null && request.auth.token.role == 'admin';
      
      // Prevent creation/deletion by users
      allow create: if false;
      allow delete: if false;
    }

    // Audit logs for compliance
    match /auditLogs/{logId} {
      // Only admins can read audit logs (Optimized: uses Custom Claims)
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      
      // Users can read their own audit logs (for privacy/GDPR compliance)
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Prevent user creation/updates (backend only via Cloud Functions)
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Email logs for tracking and debugging
    match /emailLogs/{logId} {
      // Only admins can read email logs (Optimized: uses Custom Claims)
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      
      // Users can read their own email logs
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Backend only operations
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Access token audit history
    match /accessTokenAudit/{auditId} {
      // Only admins can read (Optimized: uses Custom Claims)
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      
      // Users can read audit history for their own tokens
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Backend only
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ==================== EXISTING RULES ====================

    // Analytics - public read for profile views, write by system
    match /analytics/{slug} {
      // globalStats is public (marketing stats on homepage - no sensitive data)
      // Other analytics documents require authentication
      allow read: if slug == 'globalStats' || request.auth != null;
      allow write: if request.auth != null; // Authenticated users can write events
      
      // Analytics events subcollection
      match /events/{eventId} {
        allow read: if request.auth != null; // Authenticated users only
        allow create: if request.auth != null; // Authenticated users can create events
        allow delete: if false; // Prevent deletion
      }
      
      // Engagement metrics subcollection
      match /engagement/{document=**} {
        allow read: if request.auth != null; // Authenticated users only
        allow write: if false; // Server-side only
      }
      
      // Request statistics subcollection
      match /requests/{document=**} {
        allow read: if request.auth != null; // Authenticated users only
        allow write: if false; // Server-side only
      }
      
      // View analytics subcollection
      match /views/{document=**} {
        allow read: if request.auth != null; // Authenticated users only
        allow write: if false; // Server-side only
      }
    }

    // Resume profiles - users can read/write their own
    match /resumeProfiles/{profileId} {
      // Allow authenticated users to read their own resumes
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Only authenticated users can create resumes (must be for themselves)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Only the owner can update their resume
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      // Only the owner can delete their resume
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Access Requests subcollection (existing)
      match /accessRequests/{requestId} {
        allow read: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/resumeProfiles/$(profileId)).data.userId;
        allow create: if request.auth != null
          && request.auth.token.role in ['recruiter', 'admin']
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.status == 'pending';
      }

      // Access Grants subcollection (existing)
      match /accessGrants/{grantId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.toUserId;
        allow read: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/resumeProfiles/$(profileId)).data.userId;
      }
    }

    // Notifications
    match /notifications/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==================== SYSTEM COLLECTIONS ====================
    
    // System configuration is restricted to server/API usage only
    match /config/system {
      allow read, write: if false;
    }

    // System configuration and ID generator
    // These are backend/server-only operations
    // Backend (Cloud Functions, authenticated server endpoints) can read/write
    // Clients cannot access directly
    match /system/{document=**} {
      // Deny all client access to system collections
      // The system collection should only be accessed via:
      // 1. Cloud Functions (server-side operations)
      // 2. Authenticated Next.js API routes that verify permissions
      allow read: if false;
      allow write: if false;
      
      // For future reference: if you need to allow Cloud Functions access,
      // they use the Firebase Admin SDK which bypasses these rules automatically
    }

    // ==================== DRAFT RESUME COLLECTIONS ====================
    
    // Draft resumes - only the owner can access their drafts
    match /drafts/{draftId} {
      // Owner can read their own drafts
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Owner can create drafts for themselves
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Owner can update their own drafts
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Owner can delete their own drafts
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Draft ID mappings - server-only (used for ID uniqueness verification)
    match /draftIdMapping/{draftId} {
      allow read: if false;
      allow write: if false;
    }

    // Search quota tracking - server-only
    match /searchQuotas/{userId} {
      allow read: if false;
      allow write: if false;
    }

    // New Resumes Collection (Sequential IDs)
    match /resumes/{resumeId} {
      // Allow authenticated users to read their own resumes
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // SECURITY FIX: Allow recruiters to read published resumes (not being edited)
      // This enables the AI search functionality to work for recruiters
      // Optimized: uses Custom Claims
      allow read: if request.auth != null 
        && request.auth.token.role == 'recruiter'
        && resource.data.isBeingEdited == false;
      
      // Allow admins to read all resumes (Optimized: uses Custom Claims)
      allow read: if request.auth != null 
        && request.auth.token.role == 'admin';
      
      // Resume writes are performed server-side via Admin SDK
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Global Resumes Collection (for search/listing)
    match /allResumes/{resumeId} {
      allow read: if request.auth != null; // Authenticated users only
      allow write: if false; // Only backend can write
    }
  }
}