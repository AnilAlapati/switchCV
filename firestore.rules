rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can read and write their own profiles
    match /profiles/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==================== RECRUITER WORKFLOW ====================

    // Recruiter contact requests
    match /recruiterRequests/{requestId} {
      // Candidate can read their own requests
      allow read: if request.auth != null && request.auth.uid == resource.data.toUserId;
      // Recruiter can read their own requests
      allow read: if request.auth != null && request.auth.uid == resource.data.fromRecruiter.recruiterId;
      // Admins can read all requests (add role check if needed)
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Recruiters can create requests
      allow create: if request.auth != null;
      
      // Only admins can update (to approve/deny)
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Prevent deletion
      allow delete: if false;
    }

    // Access tokens for recruiter PII access
    match /accessTokens/{tokenId} {
      // Recruiters can read their own tokens
      allow read: if request.auth != null && request.auth.uid == resource.data.recruiterId;
      // Candidates can verify tokens for their data
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Only backend can create tokens
      allow create: if false;
      
      // Only backend can update (revoke, track usage)
      allow update: if false;
      
      // Prevent deletion
      allow delete: if false;
    }

    // Recruiter notifications
    match /recruiterNotifications/{notificationId} {
      // Recruiters can read their own notifications
      allow read: if request.auth != null && request.auth.uid == resource.data.recruiterId;
      // Recruiters can update their own (mark as read)
      allow update: if request.auth != null && request.auth.uid == resource.data.recruiterId;
      
      // Prevent creation/deletion by users (backend only)
      allow create: if false;
      allow delete: if false;
    }

    // Admin notifications for request review
    match /adminNotifications/{notificationId} {
      // Only admins can read
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Admins can update (mark as read)
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Prevent creation/deletion by users
      allow create: if false;
      allow delete: if false;
    }

    // Audit logs for compliance
    match /auditLogs/{logId} {
      // Only admins can read audit logs
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Users can read their own audit logs (for privacy/GDPR compliance)
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Prevent user creation/updates (backend only via Cloud Functions)
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Email logs for tracking and debugging
    match /emailLogs/{logId} {
      // Only admins can read email logs
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Users can read their own email logs
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Backend only operations
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Access token audit history
    match /accessTokenAudit/{auditId} {
      // Only admins can read
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Users can read audit history for their own tokens
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Backend only
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ==================== EXISTING RULES ====================

    // Analytics - public read for profile views, write by system
    match /analytics/{slug} {
      allow read: if true; // Public read for analytics
      allow write: if request.auth != null; // Authenticated users can write events
      
      // Analytics events subcollection
      match /events/{eventId} {
        allow read: if true; // Public read
        allow create: if request.auth != null; // Authenticated users can create events
        allow delete: if false; // Prevent deletion
      }
      
      // Engagement metrics subcollection
      match /engagement/{document=**} {
        allow read: if true; // Public read
        allow write: if false; // Server-side only
      }
      
      // Request statistics subcollection
      match /requests/{document=**} {
        allow read: if true; // Public read
        allow write: if false; // Server-side only
      }
      
      // View analytics subcollection
      match /views/{document=**} {
        allow read: if true; // Public read
        allow write: if false; // Server-side only
      }
    }

    // Resume profiles - users can read/write their own, public read for published resumes
    match /resumeProfiles/{profileId} {
      // Allow public read for published resumes (anyone can view shared resumes)
      allow read: if resource.data.published == true;
      // Allow authenticated users to read their own resumes
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow querying/listing published resumes for anyone
      // This enables getDocs(query(collection, where("published", "==", true)))
      allow list: if true;
      
      // Only authenticated users can create resumes (must be for themselves)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Only the owner can update their resume
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      // Only the owner can delete their resume
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Access Requests subcollection (existing)
      match /accessRequests/{requestId} {
        allow read: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/resumeProfiles/$(profileId)).data.userId;
        allow create: if request.auth != null;
      }

      // Access Grants subcollection (existing)
      match /accessGrants/{grantId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.toUserId;
        allow read: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/resumeProfiles/$(profileId)).data.userId;
      }
    }

    // Notifications
    match /notifications/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==================== SYSTEM COLLECTIONS ====================
    
    // System configuration and ID generator
    // These are backend/server-only operations
    // Read: authenticated users only (for debugging)
    // Write: allow for bootstrapping/initialization, can be restricted later
    match /system/{document=**} {
      // Allow reads for authenticated users (for status checks)
      allow read: if request.auth != null;
      
      // Allow writes for authenticated users (for initialization and updates)
      // This enables the /api/admin/init-system endpoint to work
      allow write: if request.auth != null;
      
      // For production, consider restricting to Cloud Functions only:
      // allow write: if false; // Disable client writes, use Cloud Functions instead
    }
  }
}