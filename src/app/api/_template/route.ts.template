/**
 * POST /api/your-feature
 */
export async function POST(request: NextRequest) {
  // ✅ Step 2: CORS validation
  const corsError = validateCorsRequest(request);
  if (corsError) return corsError;

  // ✅ Step 3: Authentication (NEVER skip this)
  const { userId, error } = await getAuthenticatedUserId(request);
  if (error) return error;

  // ✅ Step 4: Rate limiting
  const rateLimit = await applyRateLimit(userId!);
  if (!rateLimit.allowed) return rateLimit.response;

  try {
    // ✅ Step 5: Validate input with Zod (NEVER use raw request.json())
    const parseResult = PostInputSchema.safeParse(await request.json());
    if (!parseResult.success) {
      return NextResponse.json(
        { error: "Invalid input", details: parseResult.error.flatten() },
        { status: 400 }
      );
    }
    const data = parseResult.data;

    // Step 6: Your business logic here
    // const result = await someService(userId!, data);
    void data; // Remove this line when implementing

    // Step 7: Return success response
    const response = NextResponse.json(
      { success: true },
      { status: 200 }
    );
    attachRateLimitHeaders(response, rateLimit.result);
    return response;
  } catch (err) {
    // ✅ Step 8: Safe error handling (NEVER return err.message to client)
    return handleApiError(err, "Operation failed");
  }
}

/**
 * GET /api/your-feature
 */
export async function GET(request: NextRequest) {
  // ✅ Authentication
  const { userId, error } = await getAuthenticatedUserId(request);
  if (error) return error;

  try {
    // Your read logic here
    void userId; // Remove this line when implementing

    return NextResponse.json({ data: [] }, { status: 200 });
  } catch (err) {
    // ✅ Safe error handling
    return handleApiError(err, "Failed to fetch data");
  }
}
