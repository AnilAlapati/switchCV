import { NextResponse } from "next/server";
import type { NextRequest } from "next/server";
import { checkEdgeRateLimit } from "@/lib/utils/edgeRateLimit";
import createMiddleware from 'next-intl/middleware';

const i18nMiddleware = createMiddleware({
    // A list of all locales that are supported
    locales: ['en', 'es', 'fr', 'de'],

    // Used when no locale matches
    defaultLocale: 'en'
});

export async function middleware(request: NextRequest) {
    const { pathname } = request.nextUrl;

    // 1. API Routes: Apply Rate Limiting Only
    if (pathname.startsWith("/api")) {
        // Identify user by IP
        const ip = request.headers.get("x-forwarded-for")?.split(",")[0] || "unknown";

        // Limit: 100 requests per minute per IP
        const limit = 100;
        const windowMs = 60 * 1000;
        const result = checkEdgeRateLimit(ip, limit, windowMs);

        const headers = new Headers(request.headers);
        headers.set("X-RateLimit-Limit", result.limit.toString());
        headers.set("X-RateLimit-Remaining", result.remaining.toString());
        headers.set("X-RateLimit-Reset", result.resetIn.toString());

        if (!result.allowed) {
            return new NextResponse(
                JSON.stringify({
                    error: "Too Many Requests",
                    message: "Global rate limit exceeded. Please slow down.",
                }),
                {
                    status: 429,
                    headers: {
                        "Content-Type": "application/json",
                        "X-RateLimit-Limit": result.limit.toString(),
                        "X-RateLimit-Remaining": "0",
                        "X-RateLimit-Reset": result.resetIn.toString(),
                    },
                }
            );
        }
        return NextResponse.next({ headers });
    }

    // 2. Page Routes: Apply i18n Middleware
    // Exclude static files and Next.js internals
    if (
        !pathname.startsWith('/_next') &&
        !pathname.includes('.') // file extensions
    ) {
        return i18nMiddleware(request);
    }

    return NextResponse.next();
}

export const config = {
    // Matcher excluding static files
    matcher: ['/((?!_next|.*\\..*).*)']
};
