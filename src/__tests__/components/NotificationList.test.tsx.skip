// src/__tests__/components/NotificationList.test.tsx
import { render, screen, waitFor } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { NotificationList } from "@/components/NotificationList";
import { Notification } from "@/types/profileSearch";
import { useAuth } from "@/hooks/useAuth";
import { useRouter } from "next/navigation";
import { updateDoc } from "firebase/firestore";

// Mock dependencies
jest.mock("@/hooks/useAuth");
jest.mock("next/navigation");
jest.mock("@/lib/firebase", () => ({
  db: {},
}));
jest.mock("firebase/firestore", () => ({
  doc: jest.fn(),
  updateDoc: jest.fn(),
}));

const mockUseAuth = useAuth as jest.MockedFunction<typeof useAuth>;
const mockUseRouter = useRouter as jest.MockedFunction<typeof useRouter>;
const mockUpdateDoc = updateDoc as jest.MockedFunction<typeof updateDoc>;

describe("NotificationList", () => {
  const mockUser = { uid: "user123", email: "test@test.com" };
  const mockRouter = { push: jest.fn() };

  const mockNotifications: Notification[] = [
    {
      id: "notif1",
      userId: "user123",
      type: "request",
      fromUserId: "user456",
      fromUserName: "John Doe",
      resumeTitle: "Senior Engineer Resume",
      resumeId: "resume1",
      timestamp: new Date(Date.now() - 3600000), // 1 hour ago
      read: false,
      message: "I'd like to see your resume",
    },
    {
      id: "notif2",
      userId: "user123",
      type: "approval",
      fromUserId: "user789",
      fromUserName: "Jane Smith",
      resumeTitle: "Product Manager Resume",
      resumeId: "resume2",
      timestamp: new Date(Date.now() - 86400000), // 1 day ago
      read: true,
    },
    {
      id: "notif3",
      userId: "user123",
      type: "denial",
      fromUserId: "user111",
      fromUserName: "Bob Johnson",
      timestamp: new Date(Date.now() - 7 * 86400000), // 7 days ago
      read: true,
    },
  ];

  beforeEach(() => {
    jest.clearAllMocks();
    mockUseAuth.mockReturnValue({
      user: mockUser as any,
      loading: false,
      signOut: jest.fn(),
      updateProfile: jest.fn(),
    } as any);
    mockUseRouter.mockReturnValue(mockRouter as any);
  });

  test("renders notification list header", () => {
    render(
      <NotificationList
        notifications={[]}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    expect(screen.getByText("Notifications")).toBeInTheDocument();
  });

  test("displays empty state when no notifications", () => {
    render(
      <NotificationList
        notifications={[]}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    expect(screen.getByText("No notifications yet")).toBeInTheDocument();
  });

  test("shows loading spinner when loading", () => {
    render(
      <NotificationList
        notifications={[]}
        loading={true}
        error={null}
        onClose={jest.fn()}
      />
    );

    expect(screen.getByText("No notifications yet")).toBeInTheDocument();
  });

  test("displays error message when error occurs", () => {
    render(
      <NotificationList
        notifications={[]}
        loading={false}
        error="Failed to load notifications"
        onClose={jest.fn()}
      />
    );

    expect(
      screen.getByText("Failed to load notifications")
    ).toBeInTheDocument();
  });

  test("renders all notifications with correct info", () => {
    render(
      <NotificationList
        notifications={mockNotifications}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    expect(screen.getByText("John Doe")).toBeInTheDocument();
    expect(screen.getByText("Jane Smith")).toBeInTheDocument();
    expect(screen.getByText("Bob Johnson")).toBeInTheDocument();
  });

  test("shows correct icons for notification types", () => {
    render(
      <NotificationList
        notifications={mockNotifications}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    expect(screen.getByText("📥")).toBeInTheDocument(); // request
    expect(screen.getByText("✅")).toBeInTheDocument(); // approval
    expect(screen.getByText("❌")).toBeInTheDocument(); // denial
  });

  test("displays correct notification messages", () => {
    render(
      <NotificationList
        notifications={mockNotifications}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    expect(
      screen.getByText("requested access to your Senior Engineer Resume")
    ).toBeInTheDocument();
    expect(
      screen.getByText(
        "approved your access request for Product Manager Resume"
      )
    ).toBeInTheDocument();
    expect(screen.getByText("denied your access request")).toBeInTheDocument();
  });

  test("displays relative timestamps", () => {
    render(
      <NotificationList
        notifications={mockNotifications}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    expect(screen.getByText("1h ago")).toBeInTheDocument();
    expect(screen.getByText("1d ago")).toBeInTheDocument();
    expect(screen.getByText("7d ago")).toBeInTheDocument();
  });

  test("shows unread indicator for unread notifications", () => {
    render(
      <NotificationList
        notifications={mockNotifications}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    // First notification (unread) should have a blue dot
    // This is harder to test directly, so we just verify the component renders
    expect(screen.getByText("John Doe")).toBeInTheDocument();
  });

  test("calls onClose when close button is clicked", async () => {
    const onClose = jest.fn();
    render(
      <NotificationList
        notifications={mockNotifications}
        loading={false}
        error={null}
        onClose={onClose}
      />
    );

    const closeButton = screen.getByLabelText("Close");
    await userEvent.click(closeButton);

    expect(onClose).toHaveBeenCalled();
  });

  test("marks notification as read on click", async () => {
    mockUpdateDoc.mockResolvedValueOnce(undefined);

    render(
      <NotificationList
        notifications={mockNotifications}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    const notification = screen.getByText("John Doe").closest("div");
    await userEvent.click(notification!);

    await waitFor(() => {
      expect(mockUpdateDoc).toHaveBeenCalledWith(expect.anything(), {
        read: true,
      });
    });
  });

  test("navigates to actionUrl on notification click if provided", async () => {
    const notificationWithAction: Notification = {
      ...mockNotifications[0],
      actionUrl: "/dashboard/requests",
    };

    mockUpdateDoc.mockResolvedValueOnce(undefined);

    render(
      <NotificationList
        notifications={[notificationWithAction]}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    const notification = screen.getByText("John Doe").closest("div");
    await userEvent.click(notification!);

    await waitFor(() => {
      expect(mockRouter.push).toHaveBeenCalledWith("/dashboard/requests");
    });
  });

  test("closes list after navigation", async () => {
    const onClose = jest.fn();
    const notificationWithAction: Notification = {
      ...mockNotifications[0],
      actionUrl: "/profile/user456",
    };

    mockUpdateDoc.mockResolvedValueOnce(undefined);

    render(
      <NotificationList
        notifications={[notificationWithAction]}
        loading={false}
        error={null}
        onClose={onClose}
      />
    );

    const notification = screen.getByText("John Doe").closest("div");
    await userEvent.click(notification!);

    await waitFor(() => {
      expect(onClose).toHaveBeenCalled();
    });
  });

  test("handles notifications without optional fields", () => {
    const minimalNotification: Notification = {
      id: "notif4",
      userId: "user123",
      type: "expiry_warning",
      timestamp: new Date(),
      read: true,
    };

    render(
      <NotificationList
        notifications={[minimalNotification]}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    expect(screen.getByText("⏰")).toBeInTheDocument();
    expect(screen.getByText("Someone")).toBeInTheDocument();
  });

  test("displays custom message when provided", () => {
    const notificationWithMessage: Notification = {
      ...mockNotifications[0],
      message: "Custom message from notification",
    };

    render(
      <NotificationList
        notifications={[notificationWithMessage]}
        loading={false}
        error={null}
        onClose={jest.fn()}
      />
    );

    expect(
      screen.getByText("Custom message from notification")
    ).toBeInTheDocument();
  });
});
