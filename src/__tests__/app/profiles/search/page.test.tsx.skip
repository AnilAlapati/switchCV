// src/__tests__/app/profiles/search/page.test.tsx
import { render, screen, waitFor } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import ProfileSearchPage from "@/app/profiles/search/page";
import { useAuth } from "@/hooks/useAuth";

// Mock dependencies
jest.mock("@/hooks/useAuth");
jest.mock("next/navigation", () => ({
  useRouter: jest.fn(() => ({
    push: jest.fn(),
  })),
}));

const mockUseAuth = useAuth as jest.MockedFunction<typeof useAuth>;

const mockFetch = jest.fn();
global.fetch = mockFetch as any;

describe("ProfileSearchPage", () => {
  const mockUser = { uid: "user123", email: "test@test.com" };

  beforeEach(() => {
    jest.clearAllMocks();
    mockUseAuth.mockReturnValue({
      user: mockUser as any,
      loading: false,
      signOut: jest.fn(),
      updateProfile: jest.fn(),
    } as any);
  });

  test("renders search page when user is authenticated", () => {
    render(<ProfileSearchPage />);

    expect(screen.getByText("Discover Professionals")).toBeInTheDocument();
    expect(
      screen.getByPlaceholderText("Search by name, username, or skills...")
    ).toBeInTheDocument();
  });

  test("shows loading state when loading", () => {
    mockUseAuth.mockReturnValue({
      user: null,
      loading: true,
      signOut: jest.fn(),
      updateProfile: jest.fn(),
    } as any);

    render(<ProfileSearchPage />);

    expect(screen.getByText("Loading...")).toBeInTheDocument();
  });

  test("redirects to /auth when not authenticated", () => {
    const mockPush = jest.fn();
    jest.mock("next/navigation", () => ({
      useRouter: jest.fn(() => ({
        push: mockPush,
      })),
    }));

    mockUseAuth.mockReturnValue({
      user: null,
      loading: false,
      signOut: jest.fn(),
      updateProfile: jest.fn(),
    } as any);

    render(<ProfileSearchPage />);
    // Note: Full redirect test requires integration testing
  });

  test("performs search on query input with debounce", async () => {
    const mockSearchResults = {
      results: [
        {
          userId: "profile1",
          displayName: "John Doe",
          username: "johndoe",
          bio: "Software Engineer",
          role: "Senior Engineer",
          skills: ["React", "Node.js"],
          hasApproval: false,
        },
      ],
    };

    mockFetch.mockResolvedValueOnce({
      ok: true,
      json: async () => mockSearchResults,
    } as Response);

    render(<ProfileSearchPage />);

    const searchInput = screen.getByPlaceholderText(
      "Search by name, username, or skills..."
    );

    await userEvent.type(searchInput, "john");

    // Wait for debounce (500ms) + API call
    await waitFor(
      () => {
        expect(mockFetch).toHaveBeenCalledWith(
          "/api/profiles/search",
          expect.objectContaining({
            method: "POST",
            body: expect.stringContaining('"query":"john"'),
          })
        );
      },
      { timeout: 1000 }
    );

    // Verify search results display
    await waitFor(() => {
      expect(screen.getByText("John Doe")).toBeInTheDocument();
    });
  });

  test("displays error message on search failure", async () => {
    mockFetch.mockResolvedValueOnce({
      ok: false,
      json: async () => ({ error: "Search service unavailable" }),
    } as Response);

    render(<ProfileSearchPage />);

    const searchInput = screen.getByPlaceholderText(
      "Search by name, username, or skills..."
    );

    await userEvent.type(searchInput, "test");

    await waitFor(
      () => {
        expect(
          screen.getByText(/Search failed: Search service unavailable/i)
        ).toBeInTheDocument();
      },
      { timeout: 1000 }
    );
  });

  test("displays no results message when search returns empty", async () => {
    mockFetch.mockResolvedValueOnce({
      ok: true,
      json: async () => ({ results: [] }),
    } as Response);

    render(<ProfileSearchPage />);

    const searchInput = screen.getByPlaceholderText(
      "Search by name, username, or skills..."
    );

    await userEvent.type(searchInput, "nonexistent");

    await waitFor(
      () => {
        expect(
          screen.getByText("No profiles found matching your search")
        ).toBeInTheDocument();
      },
      { timeout: 1000 }
    );
  });

  test("shows initial state message before search", () => {
    render(<ProfileSearchPage />);

    expect(
      screen.getByText("Start typing to search for professionals")
    ).toBeInTheDocument();
  });

  test("passes correct filter parameters to API", async () => {
    mockFetch.mockResolvedValueOnce({
      ok: true,
      json: async () => ({ results: [] }),
    } as Response);

    render(<ProfileSearchPage />);

    const searchInput = screen.getByPlaceholderText(
      "Search by name, username, or skills..."
    );

    await userEvent.type(searchInput, "engineer");

    await waitFor(
      () => {
        expect(mockFetch).toHaveBeenCalledWith(
          "/api/profiles/search",
          expect.objectContaining({
            method: "POST",
            body: expect.stringContaining('"limit":20'),
          })
        );
      },
      { timeout: 1000 }
    );
  });
});
