# Base URL Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Firebase Configuration
# Get these from Firebase Console > Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_DEBUG_LOGS=false
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_AUTH_EMULATOR_PORT=9099

# AI Configuration
# Get HuggingFace token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token
NEXT_PUBLIC_HUGGINGFACE_TOKEN=your_huggingface_token

# Get Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# Authentication Secrets
TOKEN_SECRET=replace_with_secure_random_value

# Firebase Admin SDK Configuration
# Set via environment variable or gcloud auth for local development
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# =============================================================================
# DEV MODE OVERRIDES (Development Only)
# =============================================================================
# These settings allow bypassing tier/role restrictions during local development.
# They are AUTOMATICALLY IGNORED in production builds (NODE_ENV=production).
#
# Enable dev mode (required for other overrides to work)
# NEXT_PUBLIC_DEV_MODE=true
#
# Override subscription tier for ALL users in dev
# Options: basic, premium, enterprise
# NEXT_PUBLIC_DEV_TIER=enterprise
#
# Override user role for ALL users in dev
# Options: jobseeker, recruiter, admin
# NEXT_PUBLIC_DEV_ROLE=recruiter
#
# Quick start: Uncomment these 3 lines for full feature access:
# NEXT_PUBLIC_DEV_MODE=true
# NEXT_PUBLIC_DEV_TIER=enterprise
# NEXT_PUBLIC_DEV_ROLE=recruiter
