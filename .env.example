# ==============================================================================
# SwitchCV Local Development Environment
# ==============================================================================
# Copy this file to .env.local and fill in your values
#
# ⚠️  IMPORTANT: This file is for LOCAL DEVELOPMENT ONLY
# Production secrets are managed via Firebase Secret Manager - no .env files needed!
# ==============================================================================

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Firebase Configuration (from Firebase Console > Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# AI API Keys (for local development only - production uses Secret Manager)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional AI providers (fallbacks)
# OPENAI_API_KEY=your_openai_api_key
# GROQ_API_KEY=your_groq_api_key
# HUGGINGFACE_TOKEN=your_huggingface_token

# JWT Token Secret
TOKEN_SECRET=replace_with_secure_random_value

# ==============================================================================
# DEV MODE OVERRIDES (Development Only)
# ==============================================================================
# These settings bypass tier/role restrictions during local development.
# AUTOMATICALLY IGNORED in production (NODE_ENV=production).
#
# Enable dev mode (required for other overrides to work)
# NEXT_PUBLIC_DEV_MODE=true
#
# Override subscription tier: basic, premium, enterprise
# NEXT_PUBLIC_DEV_TIER=enterprise
#
# Override user role: jobseeker, recruiter, admin
# NEXT_PUBLIC_DEV_ROLE=recruiter
#
# Quick start - uncomment for full feature access:
# NEXT_PUBLIC_DEV_MODE=true
# NEXT_PUBLIC_DEV_TIER=enterprise
# NEXT_PUBLIC_DEV_ROLE=recruiter

# Google Analytics (Production Only)
# Get your Measurement ID from: https://analytics.google.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
