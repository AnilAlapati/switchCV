# ==============================================================================
# SwitchCV Local Development Environment
# ==============================================================================
# Copy this file to .env.local and fill in your values
#
# ⚠️  IMPORTANT: This file is for LOCAL DEVELOPMENT ONLY
# Production secrets are managed via Firebase Secret Manager - no .env files needed!
# ==============================================================================

# ==================== FIREBASE [REQUIRED] ====================
# From Firebase Console > Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin SDK service account (JSON string)
FIREBASE_SERVICE_ACCOUNT=

# Google Cloud project ID (usually same as Firebase project)
GCLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT=

# ==================== APPLICATION [REQUIRED] ====================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
WEBSITE_URL=http://localhost:3000

# Auth verification
NEXT_PUBLIC_AUTH_VERIFICATION_URL=http://localhost:3000/auth/verify
NEXT_PUBLIC_AUTH_VERIFICATION_PATH=/auth/verify

# JWT Token Secret
TOKEN_SECRET=replace_with_secure_random_value

# Resume async processor URL (Cloud Function)
ASYNC_RESUME_PROCESSOR_URL=

# ==================== AI PROVIDERS [REQUIRED: at least one] ====================
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional AI providers (fallbacks)
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# XAI_API_KEY=your_xai_api_key
# GROQ_API_KEY=your_groq_api_key
# HUGGINGFACE_TOKEN=your_huggingface_token

# AI safety and audit settings
AI_GLOBAL_SAFETY_LIMIT=1000
AI_AUDIT_LOG_TTL_DAYS=90

# ==================== AUTH & SECURITY ====================
# Request signing (HMAC)
# REQUEST_SIGNING_SECRET=
# REQUEST_SIGNING_ENABLED=false
# SIGNATURE_MAX_AGE=300

# Firebase App Check
ENFORCE_APP_CHECK=false

# ==================== EMAIL (SMTP) ====================
# Required for transactional emails (verification, password reset, etc.)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SUPPORT_FEEDBACK_TO=support@switchcv.com
# SUPPORT_FEEDBACK_DRY_RUN=false

# ==================== MONITORING ====================
# Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# PostHog analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Analytics (Production Only)
# Get your Measurement ID from: https://analytics.google.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==================== FEATURE FLAGS ====================
NEXT_PUBLIC_CREATIVE_TEMPLATES_ENABLED=false
NEXT_PUBLIC_ENABLE_PREMIUM_FILTERS=false
NEXT_PUBLIC_ENABLE_SEEDING_DEBUG=false
NEXT_PUBLIC_SKIP_EMAIL_VERIFICATION=false
NEXT_PUBLIC_USE_FIRESTORE_NOTIFICATIONS=false

# ==================== DEV MODE OVERRIDES ====================
# These settings bypass tier/role restrictions during local development.
# AUTOMATICALLY IGNORED in production (NODE_ENV=production).
#
# Enable dev mode (required for other overrides to work)
# NEXT_PUBLIC_DEV_MODE=true
#
# Override subscription tier: basic, premium, enterprise
# NEXT_PUBLIC_DEV_TIER=enterprise
#
# Override user role: jobseeker, recruiter, admin
# NEXT_PUBLIC_DEV_ROLE=recruiter
#
# Quick start - uncomment for full feature access:
# NEXT_PUBLIC_DEV_MODE=true
# NEXT_PUBLIC_DEV_TIER=enterprise
# NEXT_PUBLIC_DEV_ROLE=recruiter

# ==================== EMULATORS (Development) ====================
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
# NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
# NEXT_PUBLIC_AUTH_EMULATOR_PORT=9099
# FIRESTORE_EMULATOR_HOST=localhost:8080
# NEXT_PUBLIC_FIREBASE_DEBUG_LOGS=false

# Resume mode
RESUME_MODE=production

# Logging
LOG_LEVEL=info
HEALTHCHECK_RUN_FULL=false

# ==================== QUOTA LIMITS ====================
RECRUITER_FREE_REQUEST_LIMIT=5
NEXT_PUBLIC_RECRUITER_FREE_REQUEST_LIMIT=5
# SEED_BASIC_MONTHLY_LIMIT=10
# SEED_PREMIUM_MONTHLY_LIMIT=50
# SEED_ENTERPRISE_MONTHLY_LIMIT=200
# SEED_GLOBAL_LIVE_MONTHLY_LIMIT=500

# System config cache TTL (ms)
NEXT_PUBLIC_SYSTEM_CONFIG_CACHE_TTL_MS=300000

# ==================== E2E TESTING ====================
# Playwright E2E test credentials (CI only)
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
